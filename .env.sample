#Dina strängar kan hittas inom ditt Supabase-konto och sedan connection-string.

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.[DITT_PROJEKT]:[LÖSENORD]@[aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true](https://aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true)"
# Connect to Postgres via the shared session-mode pooler (used for migrations)  
DIRECT_URL="postgresql://postgres.[DITT_PROJEKT]:[LÖSENORD]@[aws-0-eu-west-1.pooler.supabase.com:5432/postgres](https://aws-0-eu-west-1.pooler.supabase.com:5432/postgres)"